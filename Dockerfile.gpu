FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV COMFYUI_ROOT=/opt/ComfyUI
ENV OLLAMA_MODELS=/models/ollama

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip \
        git curl supervisor && \
    ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.11 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Install ComfyUI (native MiniMax H3 nodes ship in comfy_extras ≥0.30)
RUN git clone --depth 1 https://github.com/comfyanonymous/ComfyUI.git $COMFYUI_ROOT && \
    cd $COMFYUI_ROOT && \
    python -m pip install --no-cache-dir -r requirements.txt

COPY docker/extra_model_paths.yaml $COMFYUI_ROOT/extra_model_paths.yaml

# Supervisord config
COPY docker/supervisord.conf /etc/supervisor/conf.d/h3gpu.conf

# Entrypoint
COPY docker/entrypoint-gpu.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8188 11434

ENTRYPOINT ["/entrypoint.sh"]
