# H3 Video Gen — local AI director pipeline
# Copy to .env and fill in secrets. Never commit .env.

# Required for director + critic (Gemini)
GEMINI_API_KEY=

# Optional — voice (ElevenLabs documentary-style narration when ENABLE_VOICE=true)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ENABLE_VOICE=true
NARRATION_AMBIENT_MIX=0.22
NARRATION_VOICE_GAIN=1.0

# ComfyUI / MiniMax H3
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_TIMEOUT_SEC=3600

# Paths (Windows defaults matching E:\AI install)
OUTPUT_ROOT=E:/Programming/H3VideoGen/outputs
COMFY_OUTPUT_ROOT=E:/AI/ComfyUI/output
FFMPEG_PATH=C:/Users/Pradeep/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-8.1.1-full_build/bin/ffmpeg.exe
FFPROBE_PATH=C:/Users/Pradeep/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-8.1.1-full_build/bin/ffprobe.exe

# Models (must exist in ComfyUI model folders)
H3_UNET=minimax_h3_fl2va_pruned_int8_convrot.safetensors
H3_UNET_R2V=minimax_h3_ref2va_pruned_int8_convrot.safetensors
H3_CLIP=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors

# Character consistency: r2v (default) | t2v | auto
H3_MODE=r2v
H3_REF_IMAGE_SIZE=match
H3_USE_PREV_SHOT_REF=true
# Character multi-view sheet: auto | gemini | h3 | manual | none
CHARACTER_BOARD_MODE=auto
CHARACTER_SHEET_POSES_PRIMARY=5
CHARACTER_SHEET_POSES_SECONDARY=2
CHARACTER_SHEET_MAX_REFS_PER_SHOT=4
CHARACTER_SHEET_USE_H3=true
# Critic QA on each character-sheet still (retake via Gemini image if needed)
CHARACTER_SHEET_CRITIC_ENABLED=true
CHARACTER_SHEET_CRITIC_MAX_RETAKES=2
CHARACTER_SHEET_CRITIC_THRESHOLD=7.0
# Soft: keep best still if critic never PASSes (set true only if you want stricter gates)
CHARACTER_SHEET_CRITIC_REQUIRE_PASS=false
# After poses: check front vs close-up identity match
CHARACTER_SHEET_CRITIC_IDENTITY_CHECK=true
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-2.5-flash-image,gemini-3-pro-image-preview

# Generation defaults (use 960x544 + fewer steps on ~16GB GPUs; 1344x768 for higher VRAM)
DEFAULT_WIDTH=960
DEFAULT_HEIGHT=544
DEFAULT_FPS=24
DEFAULT_STEPS=16
DEFAULT_LENGTH_FRAMES=124
MAX_RETAKES=2
CRITIC_PASS_THRESHOLD=7.5
# Pre-clip still gate (Gemini image keyframe QA before full H3 video; clip critic still runs after)
PRECLIP_STILL_ENABLED=true
# auto | gemini | h3_probe | none
PRECLIP_STILL_MODE=auto
PRECLIP_MAX_RETAKES=2
PRECLIP_CRITIC_THRESHOLD=7.0
# If true, skip full H3 when stills never PASS (default soft: still proceed to H3 with best notes)
PRECLIP_REQUIRE_PASS=false
PRECLIP_H3_LENGTH_FRAMES=25
# For t2v takes, feed approved still as first_frame
PRECLIP_USE_AS_FIRST_FRAME=true
# Concurrent generation slots (1 = serial queue; raise carefully — shared GPU/Comfy)
MAX_PARALLEL_JOBS=1
# Survive restarts: save queue + running jobs to OUTPUT_ROOT/job_queue.json
QUEUE_PERSIST=true
# Re-queue incomplete projects (status running/generating/…) after unclean exit
QUEUE_AUTO_RESUME_INTERRUPTED=true

# Gemini models (use IDs that work for *your* key — 2.5/2.0 flash may 404 for new users)
GEMINI_DIRECTOR_MODEL=gemini-3.5-flash
GEMINI_CRITIC_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-3-flash-preview,gemini-3.5-flash-lite
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-3.1-flash-image-preview,gemini-3-pro-image-preview

# Local OpenAI-compatible LLM (Ollama default ; LM Studio often uses http://127.0.0.1:1234/v1)
# Director uses LOCAL_LLM_MODEL (text). Critic uses LOCAL_LLM_VISION_MODEL when frames attach.
# Install both:  ollama pull llama3.2 && ollama pull llava
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_VISION_MODEL=llava
LOCAL_LLM_TIMEOUT_SEC=300
LOCAL_LLM_MAX_TOKENS=2048
LOCAL_LLM_VISION_MAX_SIDE=512

# Provider order: gemini → local OpenAI server → offline heuristics
LLM_FALLBACK_ORDER=gemini,local_openai,offline

# Auto-start local deps on Generate / Resume (Windows defaults for this machine)
AUTO_START_COMFY=true
AUTO_START_OLLAMA=true
COMFYUI_ROOT=E:/AI/ComfyUI
# Leave empty to use <COMFYUI_ROOT>/.venv/Scripts/python.exe
COMFYUI_PYTHON=
# Optional Comfy launch flags (space-separated), e.g. --lowvram for 16GB cards
COMFYUI_EXTRA_ARGS=--lowvram
COMFY_START_TIMEOUT_SEC=300
# If another Comfy app owns the port without MiniMax H3 nodes, stop it and start COMFYUI_ROOT
COMFY_REPLACE_NON_H3=true
COMFY_REQUIRE_H3_NODES=true
OLLAMA_CMD=ollama
OLLAMA_START_TIMEOUT_SEC=60
# Fail generate with a clear error if essentials never come up (default 5 minutes)
ESSENTIALS_WAIT_SEC=300

# Auto-install missing tools/models into AI_ROOT on launch (bootstrap)
AI_ROOT=E:/AI
AUTO_INSTALL_PREREQS=true
AUTO_INSTALL_COMFY=true
# torch install is large — enable only on a bare Comfy clone
AUTO_INSTALL_COMFY_DEPS=false
AUTO_INSTALL_MODELS=true
AUTO_INSTALL_FFMPEG=true
AUTO_INSTALL_OLLAMA_MODELS=true
AUTO_INSTALL_USE_SHARED_MODELS=true
AUTO_INSTALL_DOWNLOAD_TIMEOUT_SEC=7200
# Optional: HF_TOKEN= for Hugging Face rate limits when downloading H3 weights

# UI
HOST=127.0.0.1
PORT=7860
